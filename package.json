{
  "name": "stellar-agent-guard-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Operator interface for stellar-agent-guard: no-code guardrail configuration with real on-chain deployment, telemetry from the real guard events, and a panic button with confirmed on-chain effect. A pure consumer of stellar-agent-guard-sdk and Soroban RPC.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_DEMO_MODE=true next dev",
    "build": "next build",
    "export": "EXPORT_BUILD=true next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/fuzz/*.test.ts",
    "test:docs": "node scripts/check-doc-links.mjs",
    "check:no-server": "node scripts/check-no-server.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "sandbox": "bash scripts/start-local-sandbox.sh",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:e2e": "playwright test tests/e2e",
    "test:perf": "playwright test tests/perf",
    "prove:phase3": "node scripts/prove-phase3.ts",
    "prove:phase3:emit": "node scripts/prove-phase3.ts --emit",
    "prove:phase3:diff": "node scripts/compare-proof-run.ts",
    "inspect": "node scripts/inspect-instance.ts"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stellar-agent-guard-sdk": "file:vendor/stellar-agent-guard-sdk-0.1.1.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
